generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum CrushDateContentType {
  FOOD  @map("food")
  PLACE @map("place")
}

enum CrushDatePlanStatus {
  ACTIVE    @map("active")
  BACKUP    @map("backup")
  COMPLETED @map("completed")
}

enum CrushDatePlanScenario {
  HOT   @map("hot")
  COLD  @map("cold")
  RAINY @map("rainy")
  SUNNY @map("sunny")
  FREE  @map("free")
}

enum CrushDatePlanPeriod {
  MORNING   @map("morning")
  NOON      @map("noon")
  AFTERNOON @map("afternoon")
  EVENING   @map("evening")
}

model User {
  id                         Int                @id @default(autoincrement())
  email                      String             @unique
  username                   String
  passwordHash               String
  publicWeeklyReportsEnabled Boolean            @default(false) @map("public_weekly_reports_enabled")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  weeklyReportWeeks          WeeklyReportWeek[]
}

model WeeklyReportWeek {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  weekKey     String         @map("week_key")
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  isPublished Boolean        @default(false) @map("is_published")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     WeeklyReport[]

  @@unique([userId, weekKey])
  @@index([userId, startDate(sort: Desc)])
  @@map("weekly_report_weeks")
}

model WeeklyReport {
  id        Int                @id @default(autoincrement())
  weekId    Int                @map("week_id")
  sortOrder Int                @map("sort_order")
  partLabel String             @map("part_label")
  title     String
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  week      WeeklyReportWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  items     WeeklyReportItem[]

  @@unique([weekId, sortOrder])
  @@index([weekId])
  @@map("weekly_reports")
}

model WeeklyReportItem {
  id          Int          @id @default(autoincrement())
  reportId    Int          @map("report_id")
  section     String
  sortOrder   Int          @map("sort_order")
  title       String
  description String       @default("")
  images      Json         @default("[]")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  report      WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, section, sortOrder])
  @@index([reportId])
  @@map("weekly_report_items")
}

model CrushDateContentItem {
  id           String               @id
  contentType  CrushDateContentType @map("content_type")
  cityCode     String               @default("beijing") @map("city_code")
  categoryId   String               @default("other") @map("category_id")
  name         String
  type         String
  comment      String
  image        String
  poiProvider  String?              @map("poi_provider")
  poiId        String?              @map("poi_id")
  poiTitle     String?              @map("poi_title")
  poiAddress   String?              @map("poi_address")
  poiLatitude  Decimal?             @map("poi_latitude") @db.Decimal(9, 6)
  poiLongitude Decimal?             @map("poi_longitude") @db.Decimal(10, 6)
  poiAdcode    String?              @map("poi_adcode")
  visited      Boolean              @default(false)
  visitedAt    DateTime?            @map("visited_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([contentType, createdAt(sort: Desc)])
  @@index([contentType, cityCode, visited, createdAt(sort: Desc), id(sort: Desc)])
  @@map("crush_date_content_items")
}

model CrushDatePlan {
  id             String                @id
  title          String
  status         CrushDatePlanStatus
  date           DateTime?             @db.Date
  scenario       CrushDatePlanScenario
  scenarioText   String                @map("scenario_text")
  note           String
  sourceBackupId String?               @map("source_backup_id")
  completedAt    DateTime?             @map("completed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  sourceBackup   CrushDatePlan?        @relation("CrushDateBackupActivations", fields: [sourceBackupId], references: [id], onDelete: SetNull)
  activatedPlans CrushDatePlan[]       @relation("CrushDateBackupActivations")
  items          CrushDatePlanItem[]
  photos         CrushDatePlanPhoto[]

  @@index([status, createdAt(sort: Desc)])
  @@index([completedAt(sort: Desc)])
  @@index([sourceBackupId])
  @@map("crush_date_plans")
}

model CrushDatePlanItem {
  id       String               @id
  planId   String               @map("plan_id")
  type     CrushDateContentType
  sourceId String               @map("source_id")
  title    String
  image    String
  period   CrushDatePlanPeriod
  note     String
  order    Int                  @map("sort_order")
  plan     CrushDatePlan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sourceId])
  @@index([planId, period, order])
  @@map("crush_date_plan_items")
}

model CrushDatePlanPhoto {
  id        String        @id
  planId    String        @map("plan_id")
  objectKey String        @unique @map("object_key")
  sortOrder Int           @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  plan      CrushDatePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder, createdAt])
  @@map("crush_date_plan_photos")
}

enum MianjingCategory {
  FUNDAMENTALS @map("八股")
  CODING       @map("手撕")
  ALGORITHM    @map("算法")
  SCENARIO     @map("场景题")
}

enum MianjingPriority {
  HIGH   @map("高")
  MEDIUM @map("中")
  LOW    @map("低")
}

enum MianjingMastery {
  UNKNOWN    @map("不会")
  FUZZY      @map("模糊")
  BASIC      @map("基本掌握")
  PROFICIENT @map("熟练")
}

enum MianjingRecruitmentType {
  DAILY  @map("日常")
  SUMMER @map("暑期")
  AUTUMN @map("秋招")
}

enum MianjingRound {
  FIRST  @map("一面")
  SECOND @map("二面")
  THIRD  @map("三面")
}

enum MianjingPalette {
  teal
  orange
  yellow
  red
  coral
  blue
  purple
  gray
  white
  black
}

model MianjingQuestion {
  id          String              @id @default(uuid()) @db.Uuid
  title       String
  category    MianjingCategory
  tags        String[]            @default([])
  companyIds  String[]            @default([]) @map("company_ids") @db.Uuid
  priority    MianjingPriority    @default(MEDIUM)
  mastery     MianjingMastery     @default(FUZZY)
  organized   Boolean             @default(false)
  baseCount   BigInt              @default(0) @map("base_count")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  occurrences MianjingOccurrence[]

  @@index([companyIds], type: Gin)
  @@index([updatedAt(sort: Desc), id])
  @@index([category, mastery, organized])
  @@map("mianjing_questions")
}

model MianjingCompany {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique @db.VarChar(100)
  palette     MianjingPalette       @default(purple)
  sortOrder   Int                  @map("sort_order")
  enabled     Boolean              @default(true)
  occurrences MianjingOccurrence[]

  @@index([sortOrder, id])
  @@map("mianjing_companies")
}

model MianjingOccurrence {
  id              String                   @id @default(uuid()) @db.Uuid
  questionId      String                   @map("question_id") @db.Uuid
  companyId       String                   @map("company_id") @db.Uuid
  content         String                   @default("")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  recruitmentType MianjingRecruitmentType?  @map("recruitment_type")
  round           MianjingRound?
  question        MianjingQuestion         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  company         MianjingCompany          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([questionId, createdAt(sort: Desc), id])
  @@index([companyId])
  @@map("mianjing_occurrences")
}

model PrChangeLog {
  id                   String            @id @default(uuid()) @db.Uuid
  repository           String
  prNumber             Int               @map("pr_number")
  title                String
  author               String
  url                  String
  prCreatedAt          DateTime          @map("pr_created_at") @db.Timestamptz(3)
  headSha              String            @map("head_sha")
  fileCount            Int               @map("file_count")
  filesComplete        Boolean           @map("files_complete")
  changeType           String            @default("unknown") @map("change_type")
  changeSummary        String?           @map("change_summary")
  analysisStatus       String            @default("pending") @map("analysis_status")
  analysisPartial      Boolean           @default(false) @map("analysis_partial")
  contentHash          String            @map("content_hash")
  sourceRunNumber      BigInt            @map("source_run_number")
  sourceRunAttempt     Int               @map("source_run_attempt")
  analysisAttempts     Int               @default(0) @map("analysis_attempts")
  analysisStartedAt    DateTime?         @map("analysis_started_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  files                PrChangeLogFile[]

  @@unique([repository, prNumber])
  @@index([prCreatedAt(sort: Desc), id(sort: Desc)])
  @@map("pr_change_logs")
}

model PrChangeLogFile {
  id           String      @id @default(uuid()) @db.Uuid
  prId         String      @map("pr_id") @db.Uuid
  path         String
  previousPath String?     @map("previous_path")
  status       String
  additions    Int?
  deletions    Int?
  patch        String?
  patchStatus  String      @map("patch_status")
  url          String?
  pr           PrChangeLog @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, path])
  @@map("pr_change_log_files")
}
