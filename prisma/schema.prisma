generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum CrushDateContentType {
  FOOD  @map("food")
  PLACE @map("place")
}

enum CrushDatePlanStatus {
  ACTIVE    @map("active")
  BACKUP    @map("backup")
  COMPLETED @map("completed")
}

enum CrushDatePlanScenario {
  HOT   @map("hot")
  COLD  @map("cold")
  RAINY @map("rainy")
  SUNNY @map("sunny")
  FREE  @map("free")
}

enum CrushDatePlanPeriod {
  MORNING   @map("morning")
  NOON      @map("noon")
  AFTERNOON @map("afternoon")
  EVENING   @map("evening")
}

model User {
  id                         Int                @id @default(autoincrement())
  email                      String             @unique
  username                   String
  passwordHash               String
  publicWeeklyReportsEnabled Boolean            @default(false) @map("public_weekly_reports_enabled")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  weeklyReportWeeks          WeeklyReportWeek[]
}

model WeeklyReportWeek {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  weekKey     String         @map("week_key")
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  isPublished Boolean        @default(false) @map("is_published")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     WeeklyReport[]

  @@unique([userId, weekKey])
  @@index([userId, startDate(sort: Desc)])
  @@map("weekly_report_weeks")
}

model WeeklyReport {
  id        Int                @id @default(autoincrement())
  weekId    Int                @map("week_id")
  sortOrder Int                @map("sort_order")
  partLabel String             @map("part_label")
  title     String
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  week      WeeklyReportWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  items     WeeklyReportItem[]

  @@unique([weekId, sortOrder])
  @@index([weekId])
  @@map("weekly_reports")
}

model WeeklyReportItem {
  id          Int          @id @default(autoincrement())
  reportId    Int          @map("report_id")
  section     String
  sortOrder   Int          @map("sort_order")
  title       String
  description String       @default("")
  images      Json         @default("[]")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  report      WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, section, sortOrder])
  @@index([reportId])
  @@map("weekly_report_items")
}

model CrushDateContentItem {
  id          String               @id
  contentType CrushDateContentType @map("content_type")
  name        String
  type        String
  comment     String
  image       String
  visited     Boolean              @default(false)
  visitedAt   DateTime?            @map("visited_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([contentType, createdAt(sort: Desc)])
  @@map("crush_date_content_items")
}

model CrushDatePlan {
  id               String                @id
  title            String
  status           CrushDatePlanStatus
  date             DateTime?             @db.Date
  scenario         CrushDatePlanScenario
  scenarioText     String                @map("scenario_text")
  note             String
  sourceBackupId   String?               @map("source_backup_id")
  completedAt      DateTime?             @map("completed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  sourceBackup     CrushDatePlan?        @relation("CrushDateBackupActivations", fields: [sourceBackupId], references: [id], onDelete: SetNull)
  activatedPlans   CrushDatePlan[]       @relation("CrushDateBackupActivations")
  items            CrushDatePlanItem[]

  @@index([status, createdAt(sort: Desc)])
  @@index([completedAt(sort: Desc)])
  @@index([sourceBackupId])
  @@map("crush_date_plans")
}

model CrushDatePlanItem {
  id        String               @id
  planId    String               @map("plan_id")
  type      CrushDateContentType
  sourceId  String               @map("source_id")
  title     String
  image     String
  period    CrushDatePlanPeriod
  note      String
  order     Int                  @map("sort_order")
  plan      CrushDatePlan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sourceId])
  @@index([planId, period, order])
  @@map("crush_date_plan_items")
}
