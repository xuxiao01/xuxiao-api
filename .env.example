PORT=3000
APP_MODULES="all"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xuxiao_api?schema=public"
JWT_SECRET="please_change_me"
JWT_EXPIRES_IN="7d"
# Existing User.id; leave empty for a read-only mianjing API.
MIANJING_ADMIN_USER_ID=""
OSS_REGION="oss-cn-beijing"
OSS_BUCKET="your-bucket-name"
OSS_ENDPOINT="https://oss-cn-beijing.aliyuncs.com"
OSS_PUBLIC_BASE_URL="https://your-bucket-name.oss-cn-beijing.aliyuncs.com"
OSS_ACCESS_KEY_ID="your_ram_access_key_id"
OSS_ACCESS_KEY_SECRET="your_ram_access_key_secret"
TENCENT_MAP_WEB_SERVICE_KEY="your_tencent_web_service_key"
TENCENT_MAP_API_BASE_URL="https://apis.map.qq.com"
TENCENT_MAP_TIMEOUT_MS="5000"
TENCENT_MAP_CACHE_TTL_SECONDS="600"
TENCENT_MAP_RATE_LIMIT_WINDOW_MS="60000"
TENCENT_MAP_RATE_LIMIT_MAX="30"

# 独立于 JWT_SECRET；至少 32 个随机字符，未配置时关闭游客入口
MIANJING_GUEST_JWT_SECRET=""

# PR 记录：未指定管理员／上报密钥时拒绝访问；不自动调用 AI。
PR_CHANGE_LOG_ADMIN_USER_ID=""
PR_CHANGE_LOG_INGEST_TOKEN=""
PR_CHANGE_LOG_REPOSITORIES=""
# 独立启动 worker 才分析。填写兼容接口基础地址（如 https://provider.example/v1）及原生模型 ID。
PR_CHANGE_LOG_AI_API_BASE=""
PR_CHANGE_LOG_AI_API_KEY=""
PR_CHANGE_LOG_AI_MODEL=""
